# Modèle de configuration — COPIER en `.env` et adapter.
#
#   cp .env.example .env
#
# `.env` est ignoré par git (cf. .gitignore), ce fichier-ci est suivi. Ne jamais
# mettre de vraie valeur secrète ici.

# ─────────────────────────────────────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────────────────────────────────────
# Port 5433 et non 5432 : docker-compose.yml expose la base sur 5433 pour ne pas
# entrer en conflit avec une installation PostgreSQL déjà présente sur le poste.
#
# `schema=public` est explicite : Prisma le suppose par défaut, mais l'écrire
# évite les surprises si un schéma dédié est introduit plus tard.
DATABASE_URL="postgresql://edc:edc_dev_only@localhost:5433/edc_om?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Envoi de courriels (MODELE-DONNEES.md §12)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ SMTP et NON l'API HTTP d'un fournisseur. L'EDC dispose d'un service de
# messagerie Zimbra, qui parle SMTP ; Brevo expose lui aussi un relais SMTP en
# plus de son API. Basculer de l'un à l'autre est donc un changement des seules
# variables ci-dessous — pas une ligne de code.
#
# Vide = envoi DÉSACTIVÉ, et c'est un état normal : la file `mail_en_attente`
# accumule les messages sans les émettre, et l'écran d'invitation affiche le lien
# à transmettre à la main. Rien n'échoue.
#
# Diagnostic sans rien envoyer :  npx tsx prisma/verifierMail.ts

# Brevo (provisoire, le temps de savoir si le Zimbra de l'EDC est accessible) :
#   SMTP_HOTE=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_UTILISATEUR=<identifiant SMTP du tableau de bord Brevo>
#   SMTP_MOT_DE_PASSE=<CLÉ SMTP — pas la clé d'API, ce sont deux choses distinctes>
#
# Zimbra de l'entreprise (cible) :
#   SMTP_HOTE=mail.edc.cm
#   SMTP_PORT=587
#   SMTP_UTILISATEUR=noreply@edc.cm
#   SMTP_MOT_DE_PASSE=<mot de passe de la boîte>
SMTP_HOTE=""

# 587 (STARTTLS, le cas courant), 465 (TLS dès l'ouverture) ou 2525.
# Le chiffrement est DÉDUIT du port : 465 → TLS immédiat, tout autre port →
# STARTTLS EXIGÉ. Pas de variable à régler, donc pas de « secure: true sur le
# port 587 », qui fait expirer la connexion sans message clair.
SMTP_PORT="587"

# Les deux vont ensemble. Les laisser vides si le relais accepte un envoi non
# authentifié depuis une IP de confiance — ce que fait parfois un Zimbra interne.
SMTP_UTILISATEUR=""
SMTP_MOT_DE_PASSE=""

# ⚠️ N'ACTIVER QU'EN DERNIER RECOURS. `true` accepte un certificat serveur sans
# le vérifier : le trafic reste chiffré, mais plus rien ne prouve l'identité du
# serveur — un intercepteur sur le réseau interne pourrait s'y substituer.
# Utile seulement pour un Zimbra à certificat auto-signé. La bonne solution est
# d'ajouter l'autorité de certification de l'EDC au magasin de Node via
# NODE_EXTRA_CA_CERTS, ce qui rend cette variable inutile.
SMTP_CERTIFICAT_AUTOSIGNE="false"

# Adresse d'expédition et nom affiché dans les courriels sortants.
# ⚠️ Avec Brevo, l'expéditeur doit être un domaine VÉRIFIÉ dans leur tableau de
# bord, sinon le relais refuse le message (erreur permanente, non réessayée).
MAIL_EXPEDITEUR="noreply@edc.cm"
MAIL_NOM_EXPEDITEUR="EDC — Ordres de mission"

# ─────────────────────────────────────────────────────────────────────────────
# Jours fériés (MODELE-DONNEES.md §9)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ VÉRIFIÉ le 20/08/2026 : cette source ne renvoie que 8 jours fériés pour le
# Cameroun et AUCUNE fête musulmane (ni Aïd el-Fitr, ni Aïd el-Kébir). Elle ne
# couvre donc pas le besoin à elle seule — l'Aïd doit être saisi à la main
# chaque année. La saisie manuelle l'emporte toujours sur la synchronisation.
FERIES_API_URL="https://date.nager.at/api/v3/PublicHolidays"
FERIES_PAYS="CM"

# ─────────────────────────────────────────────────────────────────────────────
# Authentification
# ─────────────────────────────────────────────────────────────────────────────
# Clé de signature des jetons de session (JWT HS256). 32 caractères minimum.
# ⚠️ La changer déconnecte TOUT LE MONDE : les jetons en circulation deviennent
# invérifiables. En production, la conserver dans un gestionnaire de secrets.
# Générer une valeur :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Adresse publique de l'application, utilisée pour construire les liens de
# définition de mot de passe imprimés par `npx tsx prisma/creerCompte.ts`.
# Sans elle, les liens pointent sur http://localhost:3000 — sans effet en
# développement, mais un lien inutilisable s'il est envoyé à un employé.
APP_URL="http://localhost:3000"
