# Modèle de configuration — COPIER en `.env` et adapter.
#
#   cp .env.example .env
#
# `.env` est ignoré par git (cf. .gitignore), ce fichier-ci est suivi. Ne jamais
# mettre de vraie valeur secrète ici.

# ─────────────────────────────────────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────────────────────────────────────
# Port 5433 et non 5432 : docker-compose.yml expose la base sur 5433 pour ne pas
# entrer en conflit avec une installation PostgreSQL déjà présente sur le poste.
#
# `schema=public` est explicite : Prisma le suppose par défaut, mais l'écrire
# évite les surprises si un schéma dédié est introduit plus tard.
DATABASE_URL="postgresql://edc:edc_dev_only@localhost:5433/edc_om?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Envoi de courriels (MODELE-DONNEES.md §12) — pas encore utilisé
# ─────────────────────────────────────────────────────────────────────────────
# Nécessaire pour le mail de définition du mot de passe et les alertes DRH.
# Le fournisseur reste À TRANCHER (Resend, Brevo, ou le serveur SMTP de l'EDC).
# Laisser vide tant que le module n'existe pas : la file `mail_en_attente`
# accumulera simplement les envois sans les émettre.
SMTP_URL=""
# Adresse d'expédition affichée dans les courriels sortants.
MAIL_EXPEDITEUR="noreply@edc.cm"

# ─────────────────────────────────────────────────────────────────────────────
# Jours fériés (MODELE-DONNEES.md §9)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ VÉRIFIÉ le 20/08/2026 : cette source ne renvoie que 8 jours fériés pour le
# Cameroun et AUCUNE fête musulmane (ni Aïd el-Fitr, ni Aïd el-Kébir). Elle ne
# couvre donc pas le besoin à elle seule — l'Aïd doit être saisi à la main
# chaque année. La saisie manuelle l'emporte toujours sur la synchronisation.
FERIES_API_URL="https://date.nager.at/api/v3/PublicHolidays"
FERIES_PAYS="CM"

# ─────────────────────────────────────────────────────────────────────────────
# Authentification
# ─────────────────────────────────────────────────────────────────────────────
# Clé de signature des jetons de session (JWT HS256). 32 caractères minimum.
# ⚠️ La changer déconnecte TOUT LE MONDE : les jetons en circulation deviennent
# invérifiables. En production, la conserver dans un gestionnaire de secrets.
# Générer une valeur :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Adresse publique de l'application, utilisée pour construire les liens de
# définition de mot de passe imprimés par `npx tsx prisma/creerCompte.ts`.
# Sans elle, les liens pointent sur http://localhost:3000 — sans effet en
# développement, mais un lien inutilisable s'il est envoyé à un employé.
APP_URL="http://localhost:3000"
