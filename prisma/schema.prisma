// ═══════════════════════════════════════════════════════════════════════════
// Congés — Statut du personnel EDC, chapitre III, articles 80 à 82
// ═══════════════════════════════════════════════════════════════════════════

/// Types décidés par la DRH. La liste exacte reste À VALIDER RH.
model TypeConge {
  code    String  @id @db.VarChar(30) /// 'ANNUEL', 'SANS_SOLDE', 'MATERNITE'…
  libelle String  @db.VarChar(150)
  /// Ce type ampute-t-il le solde annuel ?
  decompteSolde Boolean @map("decompte_solde")
  actif         Boolean @default(true)

  demandes DemandeConge[]

  @@map("type_conge")
}

/// Nécessaire au décompte des jours ouvrables.
///
/// ⚠️ VÉRIFIÉ le 20/08/2026 : aucune source publique ne suffit. L'API la plus
/// courante ne renvoie que 8 fériés pour le Cameroun et AUCUNE fête musulmane
/// (ni Aïd el-Fitr, ni Aïd el-Kébir), pourtant fériées. La saisie manuelle
/// l'emporte donc toujours sur la synchronisation.
model JourFerie {
  dateFerie DateTime     @id @map("date_ferie") @db.Date
  libelle   String       @db.VarChar(150)
  origine   OrigineFerie
  /// Vrai pour les fêtes lunaires : la date bouge d'une année sur l'autre et
  /// mérite une vérification annuelle.
  estMobile Boolean @default(false) @map("est_mobile")

  synchroniseLe DateTime? @map("synchronise_le") @db.Timestamptz(6)
  saisiPar      BigInt?   @map("saisi_par")

  saisisseur Utilisateur? @relation(fields: [saisiPar], references: [id])

  @@map("jour_ferie")
}

/// Trace des synchronisations de fériés, et surtout à partir de quelle date les
/// soldes doivent être recalculés.
///
/// ⚠️ Le recalcul ne concerne que les NON-CADRES : les cadres comptent en jours
/// calendaires, donc un férié tombant pendant leur congé ne leur rend rien.
model SynchronisationFerie {
  id                   BigInt    @id @default(autoincrement())
  annee                Int       @db.SmallInt
  source               String    @db.VarChar(100)
  nombreImportes       Int       @map("nombre_importes") @db.SmallInt
  /// Fériés protégés parce que saisis à la main : on ne les écrase jamais.
  nombreIgnoresManuels Int       @map("nombre_ignores_manuels") @db.SmallInt
  recalculRequisDepuis DateTime? @map("recalcul_requis_depuis") @db.Date
  executeLe            DateTime  @default(now()) @map("execute_le") @db.Timestamptz(6)

  @@map("synchronisation_ferie")
}

model SoldeConge {
  matricule String @db.VarChar(20)
  annee     Int    @db.SmallInt

  /// Unité OBLIGATOIRE : un nombre de jours sans son unité est inexploitable,
  /// les jours ouvrables et calendaires n'étant pas convertibles.
  unite       UniteConge
  joursAcquis Decimal    @map("jours_acquis") @db.Decimal(5, 1)
  joursPris   Decimal    @default(0) @map("jours_pris") @db.Decimal(5, 1)

  /// Art. 81-3 et 81-6 : majorations dont le droit vient de l'extérieur
  /// (maternité déclarée, administration d'origine). Saisie tracée plutôt que
  /// calculée — le sexe et le nombre d'enfants ne sont pas collectés sur la
  /// fiche employé, ils sont déclarés dans le formulaire de demande.
  majorationManuelle Decimal @default(0) @map("majoration_manuelle") @db.Decimal(5, 1)
  majorationMotif    String? @map("majoration_motif")
  majorationPar      BigInt? @map("majoration_par")

  /// Art. 80-1 : report d'un an maximum, sur autorisation EXPRESSE du DG.
  joursReportes     Decimal   @default(0) @map("jours_reportes") @db.Decimal(5, 1)
  reportAutorisePar BigInt?   @map("report_autorise_par")
  reportAutoriseLe  DateTime? @map("report_autorise_le") @db.Timestamptz(6)

  /// Art. 80-3 : prescription à 3 ans.
  prescritLe DateTime? @map("prescrit_le") @db.Date

  employe   Employe      @relation(fields: [matricule], references: [matricule])
  majorateur Utilisateur? @relation("majorationPar", fields: [majorationPar], references: [id])
  autorisateur Utilisateur? @relation("reportAutorisePar", fields: [reportAutorisePar], references: [id])

  @@id([matricule, annee])
  @@map("solde_conge")
}

model DemandeConge {
  /// ULID généré par le NAVIGATEUR : la demande peut être créée hors ligne, et
  /// un renvoi après coupure ne doit pas produire de doublon.
  id String @id @db.Char(26)

  matricule String @db.VarChar(20)
  codeType  String @map("code_type") @db.VarChar(30)

  dateDebut DateTime @map("date_debut") @db.Date
  dateFin   DateTime @map("date_fin") @db.Date
  /// Calculé selon l'unité de l'employé, jours fériés déduits pour les
  /// ouvrables. Instantané : une correction de férié n'altère pas une demande
  /// déjà validée, elle n'ajuste que le solde.
  nombreJours Decimal    @map("nombre_jours") @db.Decimal(5, 1)
  unite       UniteConge

  motif  String?
  statut StatutDemande @default(SOUMISE)

  /// Date LOCALE de soumission, pas celle de réception par le serveur.
  soumiseLe     DateTime  @map("soumise_le") @db.Timestamptz(6)
  synchroniseLe DateTime? @map("synchronise_le") @db.Timestamptz(6)

  /// La validation exige que l'admin soit EN LIGNE.
  validePar      BigInt?   @map("valide_par")
  valideLe       DateTime? @map("valide_le") @db.Timestamptz(6)
  valideDepuisIp String?   @map("valide_depuis_ip") @db.Inet
  motifRefus     String?   @map("motif_refus")

  employe   Employe      @relation(fields: [matricule], references: [matricule])
  typeConge TypeConge    @relation(fields: [codeType], references: [code])
  validateur Utilisateur? @relation(fields: [validePar], references: [id])

  @@index([matricule, dateDebut], map: "idx_demande_matricule")
  @@map("demande_conge")
}

// ═══════════════════════════════════════════════════════════════════════════
// Notifications
// ═══════════════════════════════════════════════════════════════════════════

/// Une notification est une LIGNE EN BASE, pas un état d'interface : sinon un
/// rechargement de page ferait disparaître l'information.
model Notification {
  id             BigInt           @id @default(autoincrement())
  idDestinataire BigInt           @map("id_destinataire")
  type           TypeNotification
  message        String
  lien           String?          @db.VarChar(300) /// route interne à ouvrir au clic
  luLe           DateTime?        @map("lu_le") @db.Timestamptz(6)
  creeLe         DateTime         @default(now()) @map("cree_le") @db.Timestamptz(6)

  destinataire Utilisateur @relation(fields: [idDestinataire], references: [id], onDelete: Cascade)

  @@index([idDestinataire, creeLe], map: "idx_notif_destinataire")
  @@map("notification")
}

/// File des courriels à envoyer. Un mail déclenché hors ligne part À LA
/// RECONNEXION, émis par le SERVEUR — jamais par le navigateur.
model MailEnAttente {
  id             BigInt    @id @default(autoincrement())
  destinataire   String    @db.VarChar(255)
  sujet          String    @db.VarChar(300)
  corps          String
  creeLe         DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  envoyeLe       DateTime? @map("envoye_le") @db.Timestamptz(6)
  tentatives     Int       @default(0) @db.SmallInt
  derniereErreur String?   @map("derniere_erreur")

  @@map("mail_en_attente")
}

// ═══════════════════════════════════════════════════════════════════════════
// Configuration : UNE seule ligne
// ═══════════════════════════════════════════════════════════════════════════

/// Colonnes typées et non table clé/valeur : une table `parametre(cle, valeur)`
/// perdrait le type et rendrait la borne 50–75 invérifiable en base.
/// Le verrou « une seule ligne » est un CHECK (id = 1), ajouté dans la
/// migration — Prisma ne sait pas l'exprimer.
model Configuration {
  id           Int @id @default(1) @db.SmallInt
  ageRetraite  Int @map("age_retraite") @db.SmallInt
  /// Taille des plages de numéros réservées par poste.
  taillePlageNumero Int @default(50) @map("taille_plage_numero") @db.SmallInt

  modifieLe  DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)
  modifiePar BigInt?  @map("modifie_par")

  modificateur Utilisateur? @relation(fields: [modifiePar], references: [id])

  @@map("configuration")
}
